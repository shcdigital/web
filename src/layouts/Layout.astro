---
// src/layouts/Layout.astro
// Layout base de SHC Digital — SEO + accesibilidad + CSP + nav/footer.

import "../styles/brand.css";
import "../styles/global.css";
import "../styles/pages.css";
import "../styles/briefing.css";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";
import { getCurrentLanguage } from '../i18n';
import { languageCodes, getLanguage } from '../i18n/languages';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
  activeNav?: string;
  standalone?: boolean;
  bodyClass?: string;
  lang?: string;
  slug?: string;
}

const {
  title,
  description,
  canonical = "https://shcdigital.net.ar/",
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://shcdigital.net.ar/assets/img/logo/shcdigital.png",
  noindex = false,
  activeNav = "",
  standalone = false,
  bodyClass = "",
  lang = getCurrentLanguage(),
} = Astro.props;

// Generate alternate URLs for hreflang SEO
// Strip leading language code from pathname to build neutral base path
const currentPathname = Astro.url.pathname;
const pathWithoutLang = currentPathname.replace(/^\/(es|pt|en)(?=\/|$)/, '') || '/';
const alternates: Record<string, string> = {};
for (const langCode of languageCodes) {
  const locale = getLanguage(langCode).locale;
  alternates[locale] = `https://shcdigital.net.ar/${langCode}${pathWithoutLang}`;
}
alternates['x-default'] = `https://shcdigital.net.ar/es${pathWithoutLang}`;

// Get ogLocale directly from languages definition for extensibility
const ogLocale = getLanguage(lang).locale;
const htmlLang = lang === 'es' ? 'es' : lang;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description.replace(/<[^>]*>/g, "")} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#0f0e0c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Hreflang for SEO -->
    {Object.entries(alternates).map(([locale, url]) => (
      <link rel="alternate" hreflang={locale} href={url} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="SHC Digital" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription.replace(/<[^>]*>/g, "")} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription.replace(/<[^>]*>/g, "")} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Content Security Policy — sitio estático -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://script.google.com https://cloudflareinsights.com https://briefing-api.shcdigital.net.ar https://dns.google https://countries.dev https://ipchu.com; frame-src 'none'; object-src 'none';"
    />

    <title>{title}</title>

    <!-- Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://script.google.com" />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Bebas+Neue&family=Barlow:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={bodyClass}>
    {
      standalone ? (
        <slot name="standalone" />
      ) : (
        <>
          <Navbar active={activeNav} lang={lang} />
          <slot />
          <Footer lang={lang} />
        </>
      )
    }
    <script>
      import "../scripts/app.js";
    </script>
  </body>
</html>