---
// src/pages/planes.astro
// Redirect /planes → /es/planes
import { defaultLanguage } from '../i18n/languages';

export const prerender = true;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/${defaultLanguage}/planes" />
    <meta name="robots" content="noindex" />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to /${defaultLanguage}/planes...</p>
    <script>
      window.location.replace(`/${defaultLanguage}/planes`);
    </script>
  </body>
</html>