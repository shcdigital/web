---
// src/pages/terminos.astro
// Redirect /terminos → /es/terminos
import { defaultLanguage } from '../i18n/languages';

export const prerender = true;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/${defaultLanguage}/terminos" />
    <meta name="robots" content="noindex" />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to /${defaultLanguage}/terminos...</p>
    <script>
      window.location.replace(`/${defaultLanguage}/terminos`);
    </script>
  </body>
</html>