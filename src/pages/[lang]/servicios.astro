---
// src/pages/[lang]/servicios.astro
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/ui/Hero.astro";
import GhostTitle from "../../components/ui/GhostTitle.astro";
import { setLanguage, loadTranslations, tNs } from "../../i18n";
import type { EsTranslations } from "../../i18n";

export async function getStaticPaths() {
  const { languageCodes } = await import("../../i18n/languages");
  return languageCodes.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;

setLanguage(lang);

await loadTranslations(lang);

const servicios = tNs<EsTranslations["services"]>("services");
const page = tNs<EsTranslations["servicesPage"]>("servicesPage");

const domain = "https://shcdigital.net.ar";
---
<Layout
  title={page.title.replace(/<[^>]*>/g, "")}
  description={page.description}
  canonical={`${domain}/${lang}/servicios`}
  lang={lang}
  slug="servicios"
>
  <Hero lang={lang} />

  <section id="servicios" class="site-section" aria-labelledby="servicios-title">
    <div class="container">
      <p class="mono-label">{page.label}</p>
      <h2 id="servicios-title" class="big-title"><GhostTitle title={page.title} /></h2>
      <p>{page.description}</p>

      <div class="serv-grid">
        {servicios.items.map((s) => (
          <div class="serv-card">
            <div class="serv-icon">[ {s.n} ] {s.chip}</div>
            <h3 class="serv-title">{s.title}</h3>
            <p class="serv-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>