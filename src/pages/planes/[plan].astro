---
// src/pages/planes/[plan].astro
// Redirect /planes/<plan> → /<defaultLanguage>/planes/<plan>
import { defaultLanguage } from '../../i18n/languages';
import { planesDetalle } from '../../data/planes-detalle.js';

export function getStaticPaths() {
  return planesDetalle.map((p) => ({ params: { plan: p.slug } }));
}

const redirectUrl = `/${defaultLanguage}/planes/${Astro.params.plan}`;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={"0; url=" + redirectUrl} />
    <meta name="robots" content="noindex" />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to {redirectUrl}...</p>
  </body>
</html>