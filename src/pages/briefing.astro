---
// src/pages/briefing.astro
// Redirect /briefing → /es/briefing
import { defaultLanguage } from '../i18n/languages';

export const prerender = true;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/${defaultLanguage}/briefing" />
    <meta name="robots" content="noindex" />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to /${defaultLanguage}/briefing...</p>
    <script>
      window.location.replace(`/${defaultLanguage}/briefing`);
    </script>
  </body>
</html>