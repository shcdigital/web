---
// src/pages/github-pages.astro
// Redirect /github-pages → /es/github-pages
import { defaultLanguage } from '../i18n/languages';

export const prerender = true;
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/${defaultLanguage}/github-pages" />
    <meta name="robots" content="noindex" />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to /${defaultLanguage}/github-pages...</p>
    <script>
      window.location.replace(`/${defaultLanguage}/github-pages`);
    </script>
  </body>
</html>