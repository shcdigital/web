---
// src/pages/servicios.astro
// Servicios de SHC Digital — contenido idéntico a servicios.html.

import Layout from "../layouts/Layout.astro";

const servicios = [
  {
    n: "01",
    chip: "Infraestructura Legal",
    title: "REGISTRO DE DOMINIO",
    desc: "Asesoramiento técnico y legal completo para el registro y delegación de dominios oficiales (.ar o comerciales). Aseguramos la titularidad correcta de tu marca en internet desde el primer día.",
  },
  {
    n: "02",
    chip: "Identidad Visual",
    title: "DISEÑO WEB CON IA",
    desc: "Interfaces bajo una estética limpia, tipográfica y editorial. Diseños minimalistas orientados a profesionales que buscan transmitir sofisticación y claridad absoluta. Sin plantillas genéricas.",
  },
  {
    n: "03",
    chip: "Seguridad y DNS",
    title: "CLOUDFLARE HARDENING",
    desc: "Capas perimetrales de seguridad global. Registros DNS, firewalls WAF, optimización de caché perimetral y certificados SSL/TLS cifrados de extremo a extremo.",
  },
  {
    n: "04",
    chip: "Serverless",
    title: "GITHUB PAGES",
    desc: "Repositorios con pipelines automatizados. Despliegues estáticos con costo de mantenimiento cero — $0 de hosting mensual — y disponibilidad de servidores del 99.99%.",
    extra: true,
  },
  {
    n: "05",
    chip: "Automatizaciones",
    title: "FORMULARIOS + ALERTAS",
    desc: "Integración asincrónica mediante APIs. Cada consulta guarda datos en Google Sheets, notifica por WhatsApp y envía un mail de confirmación al cliente en milisegundos.",
  },
  {
    n: "06",
    chip: "WPO & SEO",
    title: "CORE WEB VITALS",
    desc: "Puntajes cercanos al 100% en Google Lighthouse. Minificación de scripts, compresión WebP/AVIF y optimización de renderizado crítico para máxima performance y posicionamiento.",
  },
];
---

<Layout
  title="Servicios — SHC Digital"
  description="Servicios de SHC Digital — Diseño web con IA, GitHub Pages, Cloudflare, SEO y automatizaciones."
  canonical="https://shcdigital.net.ar/servicios"
  activeNav="servicios"
>
  <header class="page-header">
    <div class="container">
      <p class="mono-label">// soluciones digitales</p>
      <h1 class="big-title">SERVICIOS<br /><span class="ghost">ESPECIALIZADOS</span></h1>
      <p class="page-header-desc">
        Infraestructura web de alta velocidad y diseño minimalista. Eliminamos la complejidad
        técnica para que tu identidad digital funcione sin interrupciones y sin costos mensuales.
      </p>
    </div>
  </header>

  <main>
    <section class="svc-section" aria-labelledby="svc-h">
      <div class="container">
        <p class="mono-label">Qué hacemos</p>
        <h2 id="svc-h" class="big-title">TODO LO<br /><span class="ghost">QUE INCLUYE</span></h2>
        <div class="svc-grid">
          {
            servicios.map((s) => (
              <div class="proc-step">
                <div class="proc-n" aria-hidden="true">{s.n}</div>
                <span class="proc-chip">{s.chip}</span>
                <h3 class="proc-title">{s.title}</h3>
                <p class="proc-desc">{s.desc}</p>
                {
                  s.extra && (
                    <p class="proc-desc">
                      <a href="/github-pages" class="inline-link">Condiciones y límites del hosting →</a>
                    </p>
                  )
                }
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <div class="page-cta">
      <div class="container">
        <p class="mono-label">Empezá hoy</p>
        <h2 class="big-title">¿LISTO PARA<br /><span class="ghost">EMPEZAR?</span></h2>
        <p>Contanos tu proyecto y te preparamos una propuesta en menos de 24 horas.</p>
        <a href="/#contacto" class="btn-fill">→ Consultar ahora</a>
      </div>
    </div>
  </main>
</Layout>
