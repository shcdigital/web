---
// src/components/ui/Navbar.astro
// Nav fija de SHC Digital con menú móvil accesible (aria-expanded) y selector de idioma

import LanguageSwitcher from '../LanguageSwitcher/LanguageSwitcher.astro';
import { t, loadTranslations } from '../../i18n';

interface Props {
  active?: string;
  lang?: string;
}

const { active = "", lang = "es" } = Astro.props;

await loadTranslations(lang);

const links = [
  { label: t("common.navHome", { lang }), href: `/${lang}/`, id: "" },
  { label: t("common.navServices", { lang }), href: `/${lang}/servicios`, id: "servicios" },
  { label: t("common.navProcess", { lang }), href: `/${lang}/#proceso`, id: "proceso" },
  { label: t("common.navPlans", { lang }), href: `/${lang}/#precios`, id: "precios" },
  { label: t("common.navClients", { lang }), href: "https://clientes.shcdigital.net.ar", id: "clientes" },
];
---

<nav class="site-nav" aria-label={t("common.navAria", { lang })}>
  <a href={`/${lang}/`} class="nav-logo" aria-label={t("common.logoAria", { lang })}>
    <span class="logo-type" aria-hidden="true">SHC<span>.</span>DIGITAL</span>
  </a>

  <button
    class="nav-toggle"
    id="nav-toggle"
    aria-controls="nav-links"
    aria-expanded="false"
    type="button"
  >
    {t("common.menu", { lang })}
  </button>

  <ul class="nav-links" id="nav-links" role="list">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[active === l.id && l.id !== "" ? "is-active" : ""]}
            aria-current={active === l.id && l.id !== "" ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href={`/${lang}/#contacto`} class="nav-cta">→ {t("common.navCta", { lang })}</a>
    </li>
  </ul>

  <div class="language-switcher-container">
    <LanguageSwitcher lang={lang} />
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-links");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(open));
    });
    menu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        menu.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
    window.addEventListener("scroll", () => {
      if (window.scrollY > 100) {
        menu.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
