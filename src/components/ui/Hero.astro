---
// src/components/ui/Hero.astro
// Hero de la home — título, subtítulo, CTAs y panel lateral de stats.

interface Stat {
  value?: string;
  unit?: string;
  label: string;
  desc: string;
  muted?: string;
  small?: boolean;
}

interface Props {
  stats: Stat[];
  ticker: string[];
}

const { stats, ticker } = Astro.props;
---

<div class="hero" role="banner">
  <div class="hero-main">
    <div class="hero-text-block">
      <p class="hero-tag">// diseño web con inteligencia artificial</p>
      <h1 class="hero-h1">
        TU<br />
        <span class="outline">SITIO</span><br />
        <span class="red">WEB</span>
      </h1>
      <p class="hero-sub-line">Sin costos mensuales. Para siempre.</p>
      <p class="hero-sub-note">O elegí un costo mínimo mensual de mantenimiento, sin vueltas.</p>
      <p class="hero-desc">
        Diseñamos tu presencia profesional online con IA y la publicamos en
        <strong>GitHub Pages</strong>, hosting gratuito de nivel mundial. Pagás una sola vez.
        Tu sitio online para siempre.
      </p>
      <div class="hero-btns">
        <a href="/#contacto" class="btn-fill">→ Quiero mi sitio</a>
        <a href="/#proceso" class="btn-outline">Ver proceso</a>
      </div>
    </div>

    <aside class="hero-side" aria-label="Estadísticas clave">
      {
        stats.map((s) => (
          <div class:list={["side-stat", s.small && "side-stat--sm"]}>
            {s.muted ? (
              <div class="side-num side-num--muted">{s.muted}</div>
            ) : (
              <div class="side-num">
                {s.value}
                {s.unit && <span class="unit">{s.unit}</span>}
              </div>
            )}
            <div class="side-label">{s.label}</div>
            <div class="side-desc">{s.desc}</div>
          </div>
        ))
      }
    </aside>
  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="ticker-track">
      {ticker.concat(ticker).map((item) => <div class="ticker-item">{item}<span class="ticker-sep"></span></div>)}
    </div>
  </div>
</div>
