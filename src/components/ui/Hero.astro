---
// src/components/ui/Hero.astro
// Hero de la home — título, subtítulo, CTAs y panel lateral de stats.
// Todo el contenido sale del namespace "hero" del idioma activo.

import { setLanguage, loadTranslations, tNs } from '../../i18n';
import type { EsTranslations } from '../../i18n';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;

setLanguage(lang);
await loadTranslations(lang);

interface SideStat {
  value?: string;
  unit?: string;
  label: string;
  desc: string;
  muted?: string;
  small?: boolean;
}

const hero = tNs<EsTranslations["hero"]>("hero");
const stats = Object.values(hero.stats) as SideStat[];
const ticker = hero.ticker;
---

<div class="hero" role="banner">
  <div class="hero-main">
    <div class="hero-text-block">
      <p class="hero-tag">{hero.tag}</p>
      <h1 class="hero-h1">
        {hero.titleLine1}<br />
        <span class="outline">{hero.titleLine2}</span>
        {hero.titleLine3 && (
          <>
            <br />
            <span class="red">{hero.titleLine3}</span>
          </>
        )}
      </h1>
      <p class="hero-sub-line">{hero.subLine}</p>
      <p class="hero-sub-note">{hero.subNote}</p>
      <p class="hero-desc" set:html={hero.description} />
      <div class="hero-btns">
        <a href={`/${lang}/#contacto`} class="btn-fill">{hero.ctaPrimary}</a>
        <a href={`/${lang}/#proceso`} class="btn-outline">{hero.ctaSecondary}</a>
      </div>
    </div>

    <aside class="hero-side" aria-label={hero.statsAria}>
      {
        stats.map((s) => (
          <div class:list={["side-stat", s.small && "side-stat--sm"]}>
            {s.muted ? (
              <div class="side-num side-num--muted">{s.muted}</div>
            ) : (
              <div class="side-num">
                {s.value}
                {s.unit && <span class="unit">{s.unit}</span>}
              </div>
            )}
            <div class="side-label">{s.label}</div>
            <div class="side-desc">{s.desc}</div>
          </div>
        ))
      }
    </aside>
  </div>

  <div class="hero-ticker" aria-hidden="true">
    <div class="ticker-track">
      {ticker.concat(ticker).map((item) => <div class="ticker-item">{item}<span class="ticker-sep"></span></div>)}
    </div>
  </div>
</div>